{
  "manifest_version": 3,
  "name": "Studio Tutor",
  "version": "1.1.0",
  "description": "Turns AI Studio, ChatGPT or DeepSeek into a chat-based language tutor with corrections, hover translations, speaking practice and role-play scenes.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*",
    "https://api.deepseek.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Language tutor" },
  "content_scripts": [
    {
      "matches": [
        "https://aistudio.google.com/*",
        "https://ai.studio/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://chat.deepseek.com/*"
      ],
      "js": ["content/data.js", "content/prompt.js", "content/driver.js", "content/ui.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/tutor.css"],
      "matches": [
        "https://aistudio.google.com/*",
        "https://ai.studio/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://chat.deepseek.com/*"
      ]
    }
  ]
}
